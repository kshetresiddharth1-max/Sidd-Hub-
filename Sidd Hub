    local function walk(root, name, d)
        d = d or 0
        if d > 7 then return nil end
        for _, c in ipairs(root:GetChildren()) do
            if isR(c) and c.Name == name then return c end
            local f = walk(c, name, d + 1)
            if f then return f end
        end
    end

    local function gather()
        REMOTES = {}
        for _, x in ipairs(ReplicatedStorage:GetDescendants()) do
            if isR(x) then
                local n = x.Name:lower()
                if n:find("hit") or n:find("damage") or n:find("dmg") or n:find("slash") then
                    REMOTES[#REMOTES + 1] = x
                end
            end
        end
    end

    local function findHit()
        for _, p in ipairs(PATHS) do
            local node, ok = ReplicatedStorage, true
            for i = 1, #p - 1 do
                node = node and node:FindFirstChild(p[i])
                if not node then ok = false break end
            end
            if ok and node then
                local r = node:FindFirstChild(p[#p])
                if r and isR(r) then HitRF = r; gather(); return true end
            end
        end
        local f = walk(ReplicatedStorage, "Hit")
        if f then HitRF = f; gather(); return true end
        return false
    end

    for _, child in pairs(ReplicatedStorage:GetDescendants()) do
        if isR(child) then
            local n = child.Name:lower()
            if n == "grab" then GrabRF = child
            elseif n == "updatebio" or n == "setbio" or n == "updatebioname" or n == "setbioname" then bioRemote = child
            elseif n == "updatebiocolor" or n == "setbiocolor" or n == "biocolor" then bioColorRemote = child
            elseif n == "setrpnamecolor" or n == "updaterpnamecolor" or n == "setnamecolor" then nameColorRemote = child
            elseif n == "updaterpname" or n == "setrpname" or n == "setname" then nameRemote = child
            end
        end
    end

    task.spawn(function()
        for _ = 1, 60 do
            if findHit() then break end
            task.wait(1)
        end
    end)

