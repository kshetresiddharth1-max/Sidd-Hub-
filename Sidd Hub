    local escapeGrabConn, escapeGrabFlag, grabCooldown, grabConfirm, lastIGrabbedTime = nil, false, 0, 0, 0

    local function isGrabbed()
        local ch = LocalPlayer.Character
        if not ch or ch:FindFirstChild("GRAB_weld", true) then return false end
        for _, p in Players:GetPlayers() do
            if p ~= LocalPlayer and p.Character then
                local hu = p.Character:FindFirstChildOfClass("Humanoid")
                if hu and hu.Health > 0 then
                    local gw = p.Character:FindFirstChild("GRAB_weld", true)
                    if gw and (gw:IsA("Weld") or gw:IsA("WeldConstraint")) then
                        local a, b = gw.Part0, gw.Part1
                        if a and b then
                            local aT, bT = a:IsDescendantOf(p.Character), b:IsDescendantOf(p.Character)
                            local aO, bO = a:IsDescendantOf(ch), b:IsDescendantOf(ch)
                            if (aT and bO) or (bT and aO) then return true end
                        end
                    end
                end
            end
        end
        return false
    end

    local function escapeFromGrab()
        if escapeGrabFlag or tick() - grabCooldown < 2 then return end
        grabCooldown = tick()
        escapeGrabFlag = true
        local ch = LocalPlayer.Character
        local hu = ch and ch:FindFirstChildOfClass("Humanoid")
        if hu and hu.Health > 0 then hu.Health = 0 end
        task.wait(0.5)
        escapeGrabFlag = false
        grabConfirm = 0
    end

    local function startEscapeGrab()
        if escapeGrabConn then escapeGrabConn:Disconnect() end
        grabConfirm = 0
        escapeGrabConn = RunService.Heartbeat:Connect(function()
            if not Toggles.EscapeGrab or escapeGrabFlag then return end
            if tick() - lastIGrabbedTime < 1.5 then return end
            if isGrabbed() then
                grabConfirm = grabConfirm + 1
                if grabConfirm >= 3 then escapeFromGrab() end
            else
                grabConfirm = 0
            end
        end)
    end
    local function stopEscapeGrab() if escapeGrabConn then escapeGrabConn:Disconnect(); escapeGrabConn = nil end end

